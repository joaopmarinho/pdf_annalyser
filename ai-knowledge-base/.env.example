APP_NAME=ai-knowledge-base
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/knowledge
EMBEDDING_DIM=1536
UPLOAD_DIR=/app/data/uploads
